    <worksheet name='Ingresos y profit / categoría'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#e15759'>Aunque los ingresos mas altos se dan en determinados productos, las ganancias más significativas se dan en otros como en Vacuum o Sneakers</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='catalog_clean (1)+ (orders_clean (1))' name='federated.0zva72m1rchd0r13vzqsc15iumag' />
          </datasources>
          <datasource-dependencies datasource='federated.0zva72m1rchd0r13vzqsc15iumag'>
            <column caption='Profit' datatype='real' name='[Calculation_0078397479575556]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([monto_total]) - SUM([Calculation_0639148793708544]) - SUM([gasto])' />
            </column>
            <column caption='Costo total' datatype='real' name='[Calculation_0639148793708544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([costo_unitario]) * ([cantidad])' />
            </column>
            <column caption='Cantidad' datatype='integer' name='[cantidad]' role='dimension' semantic-role='' type='ordinal' />
            <column caption='Costo Unitario' datatype='real' name='[costo_unitario]' role='measure' type='quantitative' />
            <column caption='Gasto' datatype='real' name='[gasto]' role='measure' type='quantitative' />
            <column caption='Monto Total' datatype='real' name='[monto_total]' role='dimension' type='ordinal' />
            <column caption='Nombre Producto (Catalog!Clean (1))' datatype='string' name='[nombre_producto (catalog!clean (1))]' role='dimension' type='nominal' />
